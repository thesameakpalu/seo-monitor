# Copy to .env and fill in. .env is git-ignored.

# Shown in the crawler's User-Agent so site owners can reach you.
MONITOR_CONTACT=you@example.com

# Email (Gmail: use an App Password, smtp.gmail.com, port 587)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@gmail.com
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_TO=you@example.com
